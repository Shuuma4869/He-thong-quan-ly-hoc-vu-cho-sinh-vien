# Local infrastructure
POSTGRES_DB=ams
POSTGRES_USER=ams
POSTGRES_PASSWORD=ams_local_only
POSTGRES_PORT=5433
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=ams_redis_local_only

# Backend
DATABASE_URL=jdbc:postgresql://localhost:5433/ams
DATABASE_USERNAME=ams
DATABASE_PASSWORD=ams_local_only
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
SESSION_TIMEOUT=30m
AMS_SYNC_WORKER_ENABLED=true
AMS_SYNC_POLL_INTERVAL=2s
AMS_SYNC_BATCH_SIZE=4
AMS_SYNC_LOCK_TTL=2m
AMS_SYNC_STALE_TIMEOUT=3m
AMS_SYNC_MAX_ATTEMPTS=3
AMS_SYNC_BACKOFF=10s
AMS_SYNC_MANUAL_COOLDOWN=1m
AMS_SYNC_AUTO_ENABLED=false
AMS_SYNC_AUTO_SCAN_INTERVAL=5m
AMS_SYNC_AUTO_INTERVAL=24h
AMS_SYNC_AUTO_FAILURE_COOLDOWN=24h
AMS_SYNC_AUTO_BATCH_SIZE=4
AMS_SYNC_RETENTION=90d
AMS_SYNC_CLEANUP_INTERVAL=1h
AMS_SYNC_CLEANUP_BATCH_SIZE=100
AMS_SYNC_HISTORY_MAX_PAGE_SIZE=100
AMS_GOOGLE_CALENDAR_ENABLED=false
AMS_GOOGLE_CLIENT_ID=
AMS_GOOGLE_CLIENT_SECRET=
AMS_GOOGLE_REDIRECT_URI=
AMS_GOOGLE_TOKEN_KEY=
AMS_GOOGLE_KEY_VERSION=1

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080

# Integration placeholders - leave empty until each integration is implemented
RESEND_API_KEY=
AMS_ENCRYPTION_KEY=

# Phenikaa persistence: enable only after configuring a separate 32-byte Base64 key
AMS_PHENIKAA_ENABLED=false
AMS_PHENIKAA_SESSION_KEY=
AMS_PHENIKAA_KEY_VERSION=1
